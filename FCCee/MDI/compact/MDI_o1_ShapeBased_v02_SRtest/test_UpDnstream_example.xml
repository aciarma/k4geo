<?xml version="1.0" encoding="UTF-8"?>
<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

  <info name="UpDnstream example"
    title="UpDnstream example"
    url="no"
    status="development"
    version="1.0">
    <comment>
      Standalone compact file for the "UpDnstream" section type of k4geo_Beampipe_o1_v01,
      with only one such element (see test_Beampipe_UpDnstream.xml). For debug only.
    </comment>
  </info>

  <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml" />

  <includes>
    <gdmlFile  ref="local_elements.xml"/>
    <gdmlFile  ref="local_materials.xml"/>
  </includes>

  <define>
    <constant name="world_size" value="25*m"/>
    <constant name="world_x" value="world_size"/>
    <constant name="world_y" value="world_size"/>
    <constant name="world_z" value="world_size"/>

    <!-- only for standalone, should normally be included in the detector dimensions compact -->
    <constant name="env_safety" value="0.1*mm"/>
    <constant name="world_side" value="6100*mm"/>
    <constant name="tracker_region_zmax" value="10*m"/>
    <constant name="tracker_region_rmax" value="0.5*m"/>
  </define>

  <!-- dimensions first, then the detector: same order as in test_MDI_o1_ShapeBased_v02_collection.xml -->
  <include ref="test_MDI_Dimensions_Materials_o1_v02.xml"/>
  <include ref="test_Beampipe_UpDnstream.xml"/>

</lccdd>