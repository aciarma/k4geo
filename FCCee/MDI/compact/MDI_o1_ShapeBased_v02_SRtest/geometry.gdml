    <!-- ==========================================================
         Elliptical mask, upstream, z = -130 cm from chamber center,
         nested inside tube_UpStreamBeamPipe_1_1 (see position/rotation
         comment above).
         EDIT THESE VALUES to match your actual aperture / thickness:
           - MASK_APERTURE_DX/DY : ellipse semi-axes (aperture half-widths)
           - MASK_OUTER_RMAX     : crown outer radius
           - MASK_THICKNESS      : full thickness along z
         All lengths in cm (lunit="cm").
         Current values: 4mm x 7mm elliptical aperture (semi-axes dx=0.4cm,
         dy=0.7cm), 2 cm long block (dz=1.0cm half-length), circular crown
         outer shape.

         Outer radius (1.5 cm) is set FLUSH with this pipe segment's vacuum
         bore radius (rmin1=rmin2=1.5cm, constant, no taper here) - i.e.
         the mask's outer surface exactly matches the pipe's inner wall,
         as if it were a solid insert/extension of the beam pipe itself,
         rather than leaving a gap. Since this pipe segment has zero
         transverse offset relative to the global z-axis (see above), this
         is safe to do uniformly across the mask's full length without a
         worst-case-across-length calculation. Geant4's overlap tolerance
         (~1e-9 mm) should treat an exact radius match as touching, not
         overlapping - but this is the tightest possible margin, so
         re-running the overlap checker after this change is especially
         important.
         ========================================================== -->
    <eltube name="ellipticalMask_aperture_shape_" dx="0.4" dy="0.7" dz="1.0" lunit="cm"/>
    <tube name="ellipticalMask_outer_shape_" rmin="0" rmax="1.5" z="2.0" startphi="0" deltaphi="360" aunit="deg" lunit="cm"/>
    <subtraction name="ellipticalMask_upstream_shape_">
      <first ref="ellipticalMask_outer_shape_"/>
      <second ref="ellipticalMask_aperture_shape_"/>
    </subtraction>
  </solids>

